# 复制成 .env 后按需修改；所有变量都可省略，省略即用默认值。
# 变量名统一以 RAG_ 开头，由 rag.config 读取。

# 数据目录（默认 ./data）
# RAG_DATA_DIR=./data

# 切块
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# 检索
RAG_TOP_K=5

# 嵌入维度（换真实模型后这里也要改，旧索引需重建）
RAG_EMBED_DIM=256

# 本地 LLM：任何 OpenAI 兼容服务（llama.cpp / MLX / Ollama / vLLM）
# 默认对齐本机 serve-local-llm.sh 的 8000 端口；别写成 8080，那是 DSH Web GUI。
RAG_LLM_BASE_URL=http://127.0.0.1:8000/v1
RAG_LLM_MODEL=qwen3.8-27b-local
RAG_LLM_API_KEY=sk-local
RAG_LLM_TIMEOUT=120

# 设为 1 则跳过 LLM，只返回检索片段（离线可用）
RAG_OFFLINE=0
