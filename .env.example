# Copy to .env and adjust as needed. All variables are optional.

# Data directory (default ./data)
# RAG_DATA_DIR=./data

# Chunking
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# Retrieval
RAG_TOP_K=5

# Embedding dimension (rebuild the index if you change the model)
RAG_EMBED_DIM=256

# Local LLM: any OpenAI-compatible server (llama.cpp / MLX / Ollama / vLLM)
# Matches serve-local-llm.sh on port 8000. Do not use 8080 (the DSH web GUI).
RAG_LLM_BASE_URL=http://127.0.0.1:8000/v1
RAG_LLM_MODEL=Qwen3.8-27B-4bit

# Set 1 to skip the LLM and return retrieved passages only
RAG_OFFLINE=0

# Postgres + pgvector (optional). Leave empty to use SQLite.
# RAG_DB_URL=postgresql:///eap
